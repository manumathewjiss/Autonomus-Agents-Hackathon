# ===========================================
# ReleaseHub Agents – environment variables
# Copy to .env and fill in your values.
# ===========================================

# --- Required for full app ---

# Gemini (Router – question classification). Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional, e.g. Answer Composer if you switch back)
# OPENAI_API_KEY=sk-...

# Node data layer (Far) – Postgres connection
# Get from: Render Postgres, Neon, Supabase, or local Postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Python backend only ---

# Where the Node data service is running (default: local)
DATA_LAKE_SERVICE_URL=http://localhost:3000

# Optional: override OpenAI model
# OPENAI_MODEL=gpt-4.1-mini

# --- Optional: cache (Node) ---

# Redis/Valkey for fact cache (e.g. Render Key Value)
# REDIS_HOST=...
# REDIS_PORT=6379

# Debug: log Releasetrain fetch URL and record counts (Node data layer)
# DEBUG_RELEASETRAIN=1

# --- Airbyte (sponsor: ingest into Postgres) ---
# Optional: script exports to data/releasetrain_export.json; point Airbyte File source here.
# INGEST_URL=http://localhost:3000/ingest   # used by npm run ingest-releasetrain

# --- Optional: extra features ---

# Neo4j (explainability graph)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=...

# --- Deploy ---

# ENVIRONMENT=production
